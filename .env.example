SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model (default gemini-3.5-flash-lite). e.g. gemini-3.8-flash for deeper answers
GEMINI_MODEL=
# Optional: low / medium / high (empty = model default)
GEMINI_THINKING_LEVEL=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limits (optional; defaults shown) ---
AI_DAILY_LIMIT=5
AI_BURST_LIMIT=3
SCRAPE_COOLDOWN_MINUTES=15
API_REQUESTS_PER_MINUTE=120

# --- Production only (optional) ---
# Number of reverse proxies in front of Django (0 = ignore X-Forwarded-For)
NUM_PROXIES=0
# Servers exempt from the general API limit (e.g. the Next.js server)
THROTTLE_EXEMPT_IPS=127.0.0.1,::1
# Move the admin away from /admin/
ADMIN_URL=admin/
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
